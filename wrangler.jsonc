{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boro-battle",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "boro-battle.yaoban.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
